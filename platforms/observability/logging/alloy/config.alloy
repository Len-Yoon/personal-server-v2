logging {
  level  = "warn"
  format = "logfmt"
}

discovery.kubernetes "v2_pods" {
  role = "pod"

  namespaces {
    names         = ["v2-dev", "v2-verify", "argocd", "v2-observability"]
    own_namespace = false
  }

  selectors {
    role  = "pod"
    label = "lab.personal-server-v2/owner=personal-server-v2"
  }

  attach_metadata {
    node      = false
    namespace = false
  }
}

discovery.relabel "v2_logs" {
  targets = discovery.kubernetes.v2_pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_label_lab_personal_server_v2_owner"]
    action        = "keep"
    regex         = "personal-server-v2"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    action        = "keep"
    regex         = "v2-dev|v2-verify|argocd|v2-observability"
  }

  // 수집기 자신의 경고 로그를 다시 수집하는 경로를 제외함.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    action        = "drop"
    regex         = "alloy"
  }

  rule {
    target_label = "cluster"
    replacement  = "ps-v2"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    target_label = "environment"
    replacement  = "platform"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "environment"
    regex         = "v2-(dev|verify)"
    replacement   = "$1"
  }

  rule {
    target_label = "service"
    replacement  = "unlabeled"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "service"
    regex         = "(.+)"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
}

loki.source.kubernetes "v2_logs" {
  targets    = discovery.relabel.v2_logs.output
  forward_to = [loki.process.v2_guard.receiver]
}

loki.process "v2_guard" {
  forward_to = [loki.write.v2.receiver]

  // 고정 키 뒤의 값부터 줄 끝까지 제거하는 보조 장치임. 원본 로그의 비밀 제거를 대체하지 않음.
  stage.replace {
    expression = "(?i)(?:password|token|authorization|secret|private[_-]?key)[\"']?\\s*[:=]\\s*(.*)"
    replace    = "[REDACTED]"
  }

  stage.label_keep {
    values = ["cluster", "namespace", "environment", "service", "container", "pod"]
  }
}

loki.write "v2" {
  endpoint {
    url        = "http://loki.v2-observability.svc.cluster.local:3100/loki/api/v1/push"
    batch_size = "256KiB"
    batch_wait = "1s"
  }
}

// trace 수신은 로그 tail 파이프라인과 별도이며 K8s RBAC 권한을 추가하지 않음.
otelcol.receiver.otlp "v2_traces" {
  http {
    endpoint              = "0.0.0.0:4318"
    include_metadata      = false
    max_request_body_size = "512KiB"
    read_header_timeout   = "3s"
    read_timeout          = "5s"
    write_timeout         = "5s"
  }

  output {
    traces = [otelcol.processor.memory_limiter.v2_traces.input]
  }
}

otelcol.processor.memory_limiter "v2_traces" {
  check_interval = "1s"
  limit          = "160MiB"
  spike_limit    = "32MiB"

  output {
    traces = [otelcol.processor.filter.v2_traces.input]
  }
}

otelcol.processor.filter "v2_traces" {
  error_mode = "propagate"

  trace_conditions {
    context = "resource"
    conditions = [
      `not (attributes["service.name"] == "portal" or attributes["service.name"] == "book" or attributes["service.name"] == "youtube")`,
      `not (attributes["deployment.environment.name"] == "dev" or attributes["deployment.environment.name"] == "verify")`,
    ]
  }

  trace_conditions {
    context    = "spanevent"
    conditions = ["true"]
  }

  output {
    traces = [otelcol.processor.transform.v2_traces.input]
  }
}

// 앱 exporter의 allowlist에 더해 collector에서도 HTTP 최소 속성만 전달함.
otelcol.processor.transform "v2_traces" {
  error_mode = "propagate"

  trace_statements {
    context = "resource"
    statements = [
      `keep_keys(attributes, ["service.name", "deployment.environment.name"])`,
    ]
  }

  trace_statements {
    context = "span"
    statements = [
      `keep_keys(attributes, ["http.request.method", "http.route", "http.response.status_code"])`,
      `set(status.message, "")`,
      `truncate_all(attributes, 128)`,
    ]
  }

  output {
    traces = [otelcol.processor.batch.v2_traces.input]
  }
}

otelcol.processor.batch "v2_traces" {
  timeout             = "1s"
  send_batch_size     = 32
  send_batch_max_size = 64

  output {
    traces = [otelcol.exporter.otlp.v2_tempo.input]
  }
}

otelcol.exporter.otlp "v2_tempo" {
  timeout = "2s"

  client {
    endpoint = "tempo.v2-observability.svc.cluster.local:4317"
    tls {
      insecure = true
    }
  }

  sending_queue {
    enabled           = true
    num_consumers     = 1
    queue_size        = 16
    block_on_overflow = false
  }

  retry_on_failure {
    initial_interval = "1s"
    max_interval     = "3s"
    max_elapsed_time = "10s"
  }
}
